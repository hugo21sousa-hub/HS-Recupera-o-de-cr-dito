{
  "name": "hs-recuperacao-credito",
  "version": "1.0.0",
  "private": true,
  "description": "HS Recuperação de Crédito — plataforma SaaS de recuperação de crédito (servidor Node + SQLite + frontend React)",
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server/index.js",
    "start": "node --disable-warning=ExperimentalWarning src/server/index.js",
    "build": "npm --prefix web run build",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "criar-superadmin": "node --disable-warning=ExperimentalWarning scripts/criar-superadmin.mjs",
    "docs": "node scripts/gen-api-doc.mjs",
    "setup": "npm install && npm --prefix web install && npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "retencao": "node --disable-warning=ExperimentalWarning scripts/retencao.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "nodemailer": "^6.9.16"
  }
}